# config/arena_example.env — 하이브리드 외부 LLM 설정 예시
# 이 파일을 .env로 복사해서 키를 채우고: cp config/arena_example.env .env

# --- 외부 LLM (무료) — 하나만 선택 ---
# Arena (네가 지금 쓰는 Agent 모드와 같은 계열)
ARENA_API_KEY=sk-arena-...
ARENA_BASE_URL=https://api.arena.ai/v1
ARENA_MODEL=arena-large

# OpenRouter 무료 (추천 — 가입 즉시 무료 모델 무제한)
OPENROUTER_API_KEY=sk-or-v1-...
# 모델은 config/models.yaml에서 preset으로 선택

# Groq 무료 (초고속)
GROQ_API_KEY=gsk_...

# HuggingFace 무료
HF_TOKEN=hf_...

# --- 로컬 (내 PC) — 항상 로컬에 저장 ---
GHIDRA_INSTALL_DIR=/path/to/ghidra_12.1.4_PUBLIC
JAVA_HOME=/path/to/jdk-21

# --- 선택: 민감 정보 마스킹 ---
# 외부로 보내기 전 코드에서 이 문자열들을 ***로 치환
REDACT_SECRETS=API_KEY,SECRET,PASSWORD,private_key
