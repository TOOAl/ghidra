[
  {
    "name": "list_functions",
    "description": "프로그램 내 모든 함수 목록 반환. 이름, 주소, 크기 포함. 먼저 전체 구조 파악할 때 사용.",
    "input_schema": {
      "type": "object",
      "properties": {
        "filter": { "type": "string", "description": "이름 필터 (예: 'FUN_', 'main', 정규식)" },
        "limit": { "type": "integer", "default": 50 }
      }
    }
  },
  {
    "name": "decompile",
    "description": "특정 함수를 C 의사코드로 디컴파일. 리버싱 핵심 도구.",
    "input_schema": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "함수 이름 또는 주소" },
        "include_xrefs": { "type": "boolean", "default": false }
      },
      "required": ["name"]
    }
  },
  {
    "name": "list_strings",
    "description": "바이너리 내 문자열 검색. C2 주소, 키, URL, UPX 시그니처 탐지.",
    "input_schema": {
      "type": "object",
      "properties": {
        "filter": { "type": "string" },
        "limit": { "type": "integer", "default": 100 }
      }
    }
  },
  {
    "name": "get_xrefs",
    "description": "특정 함수/주소에 대한 교차 참조 (누가 호출하는지 / 무엇을 호출하는지)",
    "input_schema": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "direction": { "type": "string", "enum": ["to", "from", "both"], "default": "both" }
      },
      "required": ["name"]
    }
  },
  {
    "name": "list_imports",
    "description": "Import 테이블 목록. 패킹 탐지(개수 적음), 암호 API 탐지에 핵심.",
    "input_schema": {
      "type": "object",
      "properties": {
        "filter": { "type": "string", "description": "필터 (예: 'Crypt', 'AES')" }
      }
    }
  },
  {
    "name": "search_bytes",
    "description": "바이트 패턴 검색. 암호 상수(AES S-box), UPX stub 등 시그니처 스캔. 와일드카드 ?? 지원.",
    "input_schema": {
      "type": "object",
      "properties": {
        "pattern": { "type": "string", "description": "hex 패턴 (예: '60 BE ?? ?? ?? ??', '63 7C 77 7B')" }
      },
      "required": ["pattern"]
    }
  },
  {
    "name": "get_bytes",
    "description": "주소에서 바이트 읽기. 키 덤프, 패치 전 원본 확인, 엔트로피 계산에 사용.",
    "input_schema": {
      "type": "object",
      "properties": {
        "address": { "type": "string", "description": "주소 (예: '0x00403000')" },
        "length": { "type": "integer", "description": "읽을 바이트 수", "default": 32 }
      },
      "required": ["address"]
    }
  },
  {
    "name": "patch_bytes",
    "description": "주소에 바이트 패치. 취약점 패치, 무력화, 라이선스 체크 우회에 사용. 주의: 원본 백업 필수.",
    "input_schema": {
      "type": "object",
      "properties": {
        "address": { "type": "string", "description": "패치할 주소" },
        "bytes": { "type": "string", "description": "hex 바이트 (예: '90 90', '31 C0 C3')" },
        "comment": { "type": "string", "description": "패치 이유 주석" }
      },
      "required": ["address", "bytes"]
    }
  },
  {
    "name": "rename_function",
    "description": "함수 이름 변경. 분석 결과를 Ghidra DB에 반영. 의미있는 이름으로 복구할 때 사용.",
    "input_schema": {
      "type": "object",
      "properties": {
        "old_name": { "type": "string" },
        "new_name": { "type": "string" }
      },
      "required": ["old_name", "new_name"]
    }
  },
  {
    "name": "set_comment",
    "description": "함수/주소에 주석 추가. 취약점 근거, 분석 메모 기록.",
    "input_schema": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "comment": { "type": "string" }
      },
      "required": ["name", "comment"]
    }
  },
  {
    "name": "search_memory",
    "description": "과거 분석 기억에서 유사한 함수/버그 패턴 검색. RAG. 반드시 근거 찾을 때 사용.",
    "input_schema": {
      "type": "object",
      "properties": {
        "query": { "type": "string", "description": "검색할 내용 (예: 'C2 통신 함수')" },
        "k": { "type": "integer", "default": 3 }
      },
      "required": ["query"]
    }
  },
  {
    "name": "list_js_modules",
    "description": "Electron app.asar 내 JS 모듈 목록. Notion 분석용. REA JS 프로바이더.",
    "input_schema": {
      "type": "object",
      "properties": {
        "asar_path": { "type": "string", "description": "app.asar 경로 (예: /Applications/Notion.app/Contents/Resources/app.asar)" },
        "filter": { "type": "string", "description": "필터 (예: 'editor', 'sync')" }
      }
    }
  },
  {
    "name": "get_js_source",
    "description": "JS 모듈 소스 읽기. 블록/동기화/DB 패턴 흡수용.",
    "input_schema": {
      "type": "object",
      "properties": {
        "module": { "type": "string", "description": "모듈 경로 (예: 'editor/block.ts')" },
        "limit": { "type": "integer", "default": 2000 }
      },
      "required": ["module"]
    }
  },
  {
    "name": "list_ipc_channels",
    "description": "Electron IPC 채널 목록. 메인↔렌더러 통신 파악.",
    "input_schema": {
      "type": "object",
      "properties": {
        "filter": { "type": "string" }
      }
    }
  },
  {
    "name": "list_dotnet_info",
    "description": ".NET 어셈블리 메타데이터. REA .NET 프로바이더.",
    "input_schema": {
      "type": "object",
      "properties": {
        "path": { "type": "string" }
      }
    }
  },
  {
    "name": "list_firmware_info",
    "description": "펌웨어 region/artifact 목록. Binwalk/Unblob 기반.",
    "input_schema": {
      "type": "object",
      "properties": {
        "path": { "type": "string" }
      }
    }
  },
  {
    "name": "get_website_structure",
    "description": "웹사이트 구조/스크립트/네트워크 관찰. REA browser 프로바이더.",
    "input_schema": {
      "type": "object",
      "properties": {
        "url": { "type": "string", "description": "URL (예: https://notion.so)" }
      },
      "required": ["url"]
    }
  },
  {
    "name": "create_block",
    "description": "Notion 블록 생성 — 분석 보고서를 블록 단위로 저장. 흡수 기능.",
    "input_schema": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["text", "code", "toggle", "callout"], "default": "text" },
        "content": { "type": "string", "description": "블록 내용" },
        "parent": { "type": "string", "description": "부모 블록 ID (옵션)" }
      },
      "required": ["content"]
    }
  },
  {
    "name": "query_database",
    "description": "Notion DB처럼 session/memory 조회. 필터/정렬/롤업.",
    "input_schema": {
      "type": "object",
      "properties": {
        "filter": { "type": "string", "description": "예: 'model:qwen' 또는 'tool:decompile'" },
        "sort": { "type": "string", "enum": ["recent", "oldest"], "default": "recent" },
        "limit": { "type": "integer", "default": 10 }
      }
    }
  },
  {
    "name": "queue_sync",
    "description": "오프라인 큐에 작업 추가. 외부 LLM 오프라인 시 사용, 온라인 시 재시도.",
    "input_schema": {
      "type": "object",
      "properties": {
        "task": { "type": "string" },
        "binary": { "type": "string" }
      },
      "required": ["task"]
    }
  },
  {
    "name": "check_contradiction",
    "description": "모순 발견 — 보고서의 CONFIRMED가 증거 없이 주장됐는지 3가지 룰로 검증. 모순 있으면 등급 강등 제안.",
    "input_schema": {
      "type": "object",
      "properties": {
        "report": { "type": "string", "description": "검증할 보고서 텍스트" },
        "evidence": { "type": "object", "description": "Tool 결과 모음 (예: {\"list_strings\": [...]})" }
      },
      "required": ["report"]
    }
  },
  {
    "name": "computer_use",
    "description": "cua 흡수 — 컴퓨터 화면을 보고 클릭/타이핑. Ghidra/웹 UI 조종.",
    "input_schema": {
      "type": "object",
      "properties": {
        "action": { "type": "string", "enum": ["screenshot", "click", "type", "key"], "default": "screenshot" },
        "x": { "type": "integer", "description": "click x" },
        "y": { "type": "integer", "description": "click y" },
        "text": { "type": "string", "description": "type/key 텍스트" }
      },
      "required": ["action"]
    }
  },
  {
    "name": "live_debug",
    "description": "raddebugger 흡수 — 프로세스에 붙어 10줄 추적, 정적 vs 동적 비교.",
    "input_schema": {
      "type": "object",
      "properties": {
        "action": { "type": "string", "enum": ["attach", "trace", "detach"], "default": "trace" },
        "address": { "type": "string", "description": "추적 시작 주소" },
        "steps": { "type": "integer", "default": 10 }
      }
    }
  },
  {
    "name": "openrig_team",
    "description": "openrig 흡수 — 천재 4명을 팀(역할)으로 협업, 공유 컨텍스트로 합의.",
    "input_schema": {
      "type": "object",
      "properties": {
        "task": { "type": "string", "description": "팀 작업 (예: C2 분석)" }
      },
      "required": ["task"]
    }
  }
]
